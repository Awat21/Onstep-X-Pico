␀␀␀␀<script>
function pad(num, size) { var s = '000000000' + num; return s.substr(s.length-size); }
function update_date_time() {
var now = new Date();
document.getElementById('datetime').innerHTML = 
(now.getUTCMonth()+1)+'/'+pad(now.getUTCDate().toString(),2)+'/'+pad(now.getUTCFullYear().toString().substr(-2),2)+' '+
pad(now.getUTCHours().toString(),2)+':'+pad(now.getUTCMinutes().toString(),2)+':'+pad(now.getUTCSeconds().toString(),2);
}
var auto1Tick=-1;
var auto2Tick=0;
var auto2Rate=500/10;
var auto1=setInterval(autoRun,10);
document.addEventListener('input',function(ev){if(ev.target.form)ev.target.form.dataset.edited=1;});
function autoFastRun() {
auto2Rate=500/10
auto2Tick=5000/10;
}
function autoRun() {
auto1Tick++;
var i;
if (auto2Tick>=0) auto2Tick--;
if (auto2Tick==0) auto2Rate=500/10;
if (auto1Tick%auto2Rate==0) {
nocache='?nocache='+Math.random()*1000000;
var request = new XMLHttpRequest();
request.onreadystatechange = pageReady(ajaxPage);
request.open('GET',ajaxPage.toLowerCase()+nocache,true); request.send(null);
}
}
function pageReady(aPage) {
return function() {
if ((this.readyState==4)&&(this.status==200)) {
lines=this.responseText.split('\n');
for (var i=0; i<lines.length; i++) {
var j=lines[i].indexOf('|');
var m=0;
if (j==-1) {j=lines[i].indexOf('&');m=1;}
var v=lines[i].slice(j+1);
var k=lines[i].slice(0,j);
if (k=='call' && v=='update_date_time') {
update_date_time();
} else {
if (k!='') {var e=document.getElementById(k);
if (e!=null) {
if (m==1) { if (document.activeElement!==e && !(e.form && e.form.dataset.edited)) e.value=v; } else
if (v=='selected') e.classList.add('sel'); else
if (v=='unselected') e.classList.remove('sel'); else
if (v=='disabled') e.disabled=true; else
if (v=='enabled') e.disabled=false; else
e.innerHTML=v;
}
}
}
}
}
}
}
</script>
␀␀<script>var cc = document.getElementsByClassName('collapsible');var i;for (i = 0; i < cc.length; i++) {cc[i].addEventListener('click', function() {this.classList.toggle('active');var ct = this.nextElementSibling;if (ct.style.display === 'block') { ct.style.display = 'none'; } else { ct.style.display = 'block'; }});}</script>
