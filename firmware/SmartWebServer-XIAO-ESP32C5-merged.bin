var v=lines[i].slice(j+1);
var k=lines[i].slice(0,j);
if (k=='call' && v=='update_date_time') {
update_date_time();
} else {
if (k!='') {var e=document.getElementById(k);
if (e!=null) {
if (m==1) { if (document.activeElement!==e && !(e.form && e.form.dataset.edited)) e.value=v; } else
if (v=='selected') e.classList.add('sel'); else
if (v=='unselected') e.classList.remove('sel'); else
if (v=='disabled') e.disabled=true; else
if (v=='enabled') e.disabled=false; else
e.innerHTML=v;
}
}
}
}
}
}
}
