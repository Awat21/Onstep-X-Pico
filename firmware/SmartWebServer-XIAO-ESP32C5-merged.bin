function g(v1){s('dr',v1);}function gf(v1){s('dr',v1);autoFastRun();}function sf(key,v1){s(key,v1);autoFastRun();}let lzh; function sz(key,v1){clearTimeout(lzh);lzh=setTimeout(s,1000,key,v1);}
</script>
