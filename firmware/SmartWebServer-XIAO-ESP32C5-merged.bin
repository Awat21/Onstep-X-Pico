-color: var(--accent); } .t { margin: 0; padding: 12px 24px; background: var(--card); border-bottom: 1px solid var(--line); } .b { max-width: 1440px; margin: 0 auto; padding: 16px 16px 32px; } hr { border: none; height: 1px; background: var(--line); margin: 10px 0; } h1 { text-align: right; } .c { color: var(--accent); font-weight: 600; } .y { color: var(--alert); font-weight: 600; } a:link, a:visited { background: var(--card-hi); color: var(--link); border: 1px solid var(--line); border-radius: 6px; padding: 5px 12px; text-align: center; text-decoration: none; display: inline-block; } a:hover, a:active { border-color: var(--accent); color: var(--fg-hi); } input, select, textarea { font: inherit; font-weight: 600; color: var(--fg-hi); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; margin: 3px; text-align: center; width: 5em; } select { width: auto; text-align: left; } input[type=range] { border: none; background: none; padding: 0; accent-color: var(--accent); } input[type=checkbox], input[type=radio] { accent-color: var(--accent); } input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); } button { font: inherit; font-weight: 600; color: var(--accent); background: var(--card-hi); border: 1px solid var(--accent); border-radius: 8px; margin: 2px; padding: 4px 12px; cursor: pointer; } button:hover { background: var(--sel); } button:active, button.sel { background: var(--accent); color: var(--bg); } button:disabled { color: var(--off); border-color: var(--line); background: none; cursor: default; }␀␀␀␀<STYLE>␀</div></body></html>
␀␀␀<body>
␀</head>
␀␀␀␀<!DOCTYPE HTML>
<html>
